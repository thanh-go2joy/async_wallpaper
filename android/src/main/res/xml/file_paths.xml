<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cho phép FileProvider truy cập thư mục cache -->
    <cache-path
        name="cache"
        path="." />

    <!-- Cho phép FileProvider truy cập thư mục files -->
    <files-path
        name="files"
        path="." />

    <!-- Cho phép truy cập thư mục download (nếu cần lưu ảnh về storage) -->
    <external-path
        name="external"
        path="." />

    <!-- Tùy chọn: cho phép truy cập thư mục Pictures -->
    <external-files-path
        name="pictures"
        path="Pictures" />
</paths>
